  m_Name: 
  m_EditorClassIdentifier: 
  actualText: []
  actualTextouner: 
  faceNPC: {fileID: 503410737}
  faceProta: {fileID: 2027099791}
  npcCheckpoints: 0
  dialogo: {fileID: 1224263241}
  phrase: {fileID: 1818462097}
  currentPhrase: 0
  textFastSpeed: 0.04
  textSlowSpeed: 0.1
  text0:
  - Mi nombe es Jampierggg Lopez
  - "Sabe?, hace una ma\xF1ana muy acogedora "
  - "\xBFHa visto usted a un gato con boina y bigote pasar por aqui?? "
  - Ohh, wi wi
  - 'Por supuesto madmuasel '
  - 'Le vi reflajadas en sus ojos unas baguetes muy jugosas '
  - "Sabe, eso me recuerda a cuando de peque\xF1o iba con mis cuatro francos a la
    panaderia de la se\xF1ora Paulete a comprarme unos deliciosos curasans... "
  - aaaa curasan...
  text1:
  - Oh, por Frufru
  - Menudos modales son esos jovencita
  - "Mi nombre es Jampierg Lopez y deber\xEDas ser un poco mas educada con tus mayores"
  - 'Sabe, eso me recuerda a mi vieja amiga Janete, era mas aspera que un cardo,
    pero la delantera me volvia loco....  '
  - Aaaa Janete....
  - '*suspiro*'
  - 'En fin ese gato que tanto busca esta en la panaderia, ve '
  - ande corra
  text2:
  - "Ma\xF1ana por la ma\xF1ana pasar\xE1 el tour de Francia por aqu\xED"
  text3:
  - "\xA1Bonj\xFA madmuasel!"
  text4:
  - Bonjour!
  textouner0: 0100000001000000000000000100000001000000010000000100000001000000
  textouner1: 0100000001000000010000000100000001000000010000000100000001000000
  textouner2: 01000000
  textouner3: 01000000
  textouner4: 01000000
